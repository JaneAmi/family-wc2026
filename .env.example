# Frontend (exposed to the browser — safe, these are public keys)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (used by api/sync.js — NEVER expose the service role key in the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: protect the sync endpoint. If set, the in-app "Sync now" button won't work
# (cron still does). Leave unset for a casual family app.
# CRON_SECRET=some-long-random-string
